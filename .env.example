# .env.example — EAD Factory MCP Server
# Auto-generated by @suite/generator. Do not edit.
# Copy to .env and fill in the values before running the server.

# Authentication — this product supports a single auth flow (see below).

# Service account (OAuth2 client_credentials — e.g. Okta as a configured instance)
# description: Token endpoint URL for the OAuth2 client_credentials flow.
# isSecret: false
# isRequired: true
MCP_SVC_TOKEN_URL=

# description: OAuth2 client_credentials client ID.
# isSecret: false
# isRequired: true
MCP_SVC_CLIENT_ID=

# description: OAuth2 client_credentials client secret.
# isSecret: true
# isRequired: true
MCP_SVC_CLIENT_SECRET=

# description: Optional OAuth2 scope for the service-account token request.
# isSecret: false
# isRequired: false
MCP_SVC_SCOPE=

# Inbound Bearer verification (HTTP mode only) — NOT an auth flow and not an
# alternative to the credentials above. Leave empty unless you host this server
# over HTTP and want it to verify the tokens its callers present.
# description: RFC 7662 token introspection URL for inbound Bearer verification in HTTP mode. Opt-in, and required when MCP_HTTP_PUBLIC=true. Leave empty for stdio (local) use.
# isSecret: false
# isRequired: false
MCP_SVC_INTROSPECT_URL=

# API base URL (optional — every tool has a working built-in default)
# description: Gateway ROOT URL (e.g. https://api.int.gcloudfactory.com) — each manager's path prefix is appended automatically; do NOT include a manager path here
# isSecret: false
# isRequired: false
MCP_API_BASE_URL=

# Per-manager override (optional — takes precedence over MCP_API_BASE_URL above).
# Unlike MCP_API_BASE_URL, these are FULL base URLs used as-is (nothing appended);
# use them if a manager's gateway path prefix differs from the default below.
# description: Full base URL override for the evidence manager, used as-is (default: https://api.gcloudfactory.com/digital-trust)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_EVIDENCE=

# description: Full base URL override for the signature manager, used as-is (default: https://api.gcloudfactory.com/signature-manager)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_SIGNATURE=

# description: Full base URL override for the notification manager, used as-is (default: https://api.gcloudfactory.com/notifications)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_NOTIFICATION=

# description: Full base URL override for the chat manager, used as-is (default: https://api.gcloudfactory.com/chat-bot-manager)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_CHAT=

# Transport (optional)
# description: Which transport to run: "stdio" for local/CLI use, "http" to host the server. Empty or unset means stdio. The Docker image sets http itself, so keep this variable out of any env file you pass to the container. Unknown values fail fast at startup.
# isSecret: false
# isRequired: false
MCP_TRANSPORT=

# description: Path to a file where the SSE bridge persists its state (pollable-task delivery) across restarts. Omit to disable persistence — pollable tasks still work, but in-flight SSE subscriptions are lost on restart.
# isSecret: false
# isRequired: false
MCP_BRIDGE_STATE_FILE=

# description: HTTP port when running in hosted (HTTP) mode; ignored in stdio mode
# isSecret: false
# isRequired: false
PORT=8080

# description: Interface the HTTP transport binds to. Default 127.0.0.1 (localhost only). Set 0.0.0.0 to expose on all interfaces (containers do this automatically).
# isSecret: false
# isRequired: false
MCP_HTTP_HOST=127.0.0.1

# description: Comma-separated allowed browser Origins (DNS-rebinding defense). Empty = reject any request carrying an Origin header; non-browser clients (CLI/SDK) send no Origin and are always allowed. Use '*' to allow all.
# isSecret: false
# isRequired: false
MCP_ALLOWED_ORIGINS=

# description: Comma-separated allowed Host headers. Empty = Host validation disabled (default). When set, requests with a Host outside the list are rejected.
# isSecret: false
# isRequired: false
MCP_ALLOWED_HOSTS=

# description: Set to "true" for public/multi-tenant deployments. Activates Host validation and refuses to start unless (1) MCP_ALLOWED_ORIGINS or MCP_ALLOWED_HOSTS is set AND (2) inbound Bearer introspection is configured (MCP_SVC_INTROSPECT_URL + MCP_SVC_CLIENT_ID/SECRET) or MCP_ALLOW_UNVERIFIED_BEARER=true is set explicitly (fail-closed).
# isSecret: false
# isRequired: false
MCP_HTTP_PUBLIC=

# description: Escape hatch for MCP_HTTP_PUBLIC=true WITHOUT inbound-token introspection: set to "true" ONLY when an upstream gateway already verifies Bearer tokens. The server logs a prominent warning and forwards tokens upstream unverified.
# isSecret: false
# isRequired: false
MCP_ALLOW_UNVERIFIED_BEARER=

# description: Maximum accepted POST /mcp request-body size in bytes (default 16777216 = 16 MiB — sized so base64 file uploads within the documented tool limits fit). Oversized requests get a 413 JSON-RPC error before/while reading — closes a memory-exhaustion DoS vector in public deployments. Note: base64 file sources are capped by this limit BEFORE MCP_FILE_MAX_BYTES applies.
# isSecret: false
# isRequired: false
MCP_HTTP_MAX_BODY_BYTES=

# description: Set to "true" to allow plain http:// fileUrl downloads in evidence_create (default https-only). Private/internal addresses are rejected regardless (resolution-time check; see the documented DNS TOCTOU limitation in the hosted-deployment runbook).
# isSecret: false
# isRequired: false
MCP_ALLOW_INSECURE_FILE_URL=

# description: Maximum accepted file size in bytes for any tool that ingests a file (path/base64/url source), default 1073741824 = 1 GiB. Oversized files are rejected before upload; see each file-accepting tool's error for the exact remediation.
# isSecret: false
# isRequired: false
MCP_FILE_MAX_BYTES=

# description: Comma-separated absolute directory paths. When set, a local "path" file source must resolve under one of them (symlinks excluded). Empty (default) = no restriction.
# isSecret: false
# isRequired: false
MCP_FILE_ALLOWED_ROOTS=

# description: Comma-separated hostnames. When set, a "url" file source's host must be in this list, checked before any network call. Empty (default) = no restriction.
# isSecret: false
# isRequired: false
MCP_FILE_URL_ALLOWED_HOSTS=

# Observability (optional)
# description: Set to "true" to emit OpenTelemetry traces/metrics (requires @opentelemetry/sdk-node to be installed separately). Off by default — zero overhead for npx/stdio users.
# isSecret: false
# isRequired: false
MCP_OTEL_ENABLED=
