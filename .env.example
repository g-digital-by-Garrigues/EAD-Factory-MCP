# .env.example — EAD Factory MCP Server
# Auto-generated by @suite/generator. Do not edit.
# Copy to .env and fill in the values before running the server.

# Authentication — configure EXACTLY ONE flow. No single variable is globally
# required (the three flows are alternatives), so all are marked isRequired:false.

# Flow 1: Email / password
# description: Your EAD Factory account email (Flow 1). Configure exactly one of Flow 1, 2, or 3.
# isSecret: false
# isRequired: false
MCP_AUTH_EMAIL=

# description: Your EAD Factory account password (Flow 1, email/password accounts)
# isSecret: true
# isRequired: false
MCP_AUTH_PASSWORD=

# Flow 2: OpenID Connect (alternative to email/password)
# description: OpenID Connect issuer URL (Flow 2)
# isSecret: false
# isRequired: false
MCP_OPENID_ISSUER=

# description: OpenID Connect client ID (Flow 2)
# isSecret: false
# isRequired: false
MCP_OPENID_CLIENT_ID=

# description: OpenID Connect refresh token (Flow 2)
# isSecret: true
# isRequired: false
MCP_OPENID_REFRESH_TOKEN=

# Flow 3: Service account (OAuth2 client_credentials — e.g. Okta as a configured instance)
# description: Token endpoint URL for the OAuth2 client_credentials flow (Flow 3)
# isSecret: false
# isRequired: false
MCP_SVC_TOKEN_URL=

# description: OAuth2 client_credentials client ID (Flow 3)
# isSecret: false
# isRequired: false
MCP_SVC_CLIENT_ID=

# description: OAuth2 client_credentials client secret (Flow 3)
# isSecret: true
# isRequired: false
MCP_SVC_CLIENT_SECRET=

# description: Optional OAuth2 scope for the service-account token request (Flow 3)
# isSecret: false
# isRequired: false
MCP_SVC_SCOPE=

# description: RFC 7662 token introspection URL for inbound Bearer verification in HTTP mode. Opt-in — reuses the Flow 3 client id/secret above as the resource-server credentials.
# isSecret: false
# isRequired: false
MCP_SVC_INTROSPECT_URL=

# API base URL (optional — every tool has a working built-in default)
# description: Overrides the default upstream API host for every tool
# isSecret: false
# isRequired: false
MCP_API_BASE_URL=
# Per-manager override (optional — takes precedence over MCP_API_BASE_URL above).
# Each manager is served under its own gateway path prefix; use these if testing
# against an environment (e.g. int/pre) whose prefix differs from the default below.
# description: evidence manager base URL (default: https://api.gcloudfactory.com/digital-trust)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_EVIDENCE=
# description: signature manager base URL (default: https://api.gcloudfactory.com/signature-manager)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_SIGNATURE=
# description: notification manager base URL (default: https://api.gcloudfactory.com/notifications)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_NOTIFICATION=
# description: chat manager base URL (default: https://api.gcloudfactory.com/chat-bot-manager)
# isSecret: false
# isRequired: false
MCP_API_BASE_URL_CHAT=
# Transport (optional)
# description: HTTP port when running in hosted (HTTP) mode; ignored in stdio mode
# isSecret: false
# isRequired: false
PORT=8080

# description: Interface the HTTP transport binds to. Default 127.0.0.1 (localhost only). Set 0.0.0.0 to expose on all interfaces (containers do this automatically).
# isSecret: false
# isRequired: false
MCP_HTTP_HOST=127.0.0.1

# description: Comma-separated allowed browser Origins (DNS-rebinding defense). Empty = reject any request carrying an Origin header; non-browser clients (CLI/SDK) send no Origin and are always allowed. Use '*' to allow all.
# isSecret: false
# isRequired: false
MCP_ALLOWED_ORIGINS=

# description: Comma-separated allowed Host headers. Empty = Host validation disabled (default). When set, requests with a Host outside the list are rejected.
# isSecret: false
# isRequired: false
MCP_ALLOWED_HOSTS=

# description: Set to "true" for public/multi-tenant deployments. Activates Host validation and refuses to start unless MCP_ALLOWED_ORIGINS or MCP_ALLOWED_HOSTS is set (fail-closed).
# isSecret: false
# isRequired: false
MCP_HTTP_PUBLIC=

# description: Set to "true" to allow plain http:// fileUrl downloads in evidence_create (default https-only). Private/internal addresses are always rejected regardless.
# isSecret: false
# isRequired: false
MCP_ALLOW_INSECURE_FILE_URL=
